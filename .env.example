# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# S3 Configuration
S3_BUCKET_NAME=doc-processor-bucket
S3_UPLOAD_PREFIX=uploads/
S3_PROCESSED_PREFIX=processed/

# Celery Configuration
CELERY_BROKER_URL=sqs://
CELERY_RESULT_BACKEND=dynamodb://
DYNAMODB_TABLE_NAME=celery-results

# SNS Configuration
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:doc-processing-notifications

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Processing Configuration
MAX_FILE_SIZE=104857600  # 100MB
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,mp4,mov,avi
THUMBNAIL_SIZE=300,300

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
